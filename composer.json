{
    "name": "fsasvari/laravel-trailing-slash",
    "description": "The package that adds redirection with trailing slash to Laravel framework.",
    "keywords": [
        "redirect",
        "url",
        "uri",
        "router",
        "laravel",
        "php"
    ],
    "license": "MIT",
    "homepage": "https://github.com/fsasvari/laravel-trailing-slash",
    "authors": [
        {
            "name": "Frano Sasvari",
            "email": "sasvari.frano@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/routing": "^11|^12|^13"
    },
    "require-dev": {
        "illuminate/database": "^11|^12|^13",
        "laravel/pint": "^1.20",
        "mockery/mockery": "^1",
        "phpstan/phpstan": "^1|^2",
        "phpunit/phpunit": "^11|^12"
    },
    "autoload": {
        "psr-4": {
            "LaravelTrailingSlash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelTrailingSlash\\RoutingServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
